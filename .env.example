# Copy this file to .env and fill in required values

# ------------------------------
# HAL1000 application variables
# ------------------------------
# SQLite DB path is set by compose to /data/hal1000.db (persisted)
# You can override it here if not using compose
# HAL1000_DB_PATH=/data/hal1000.db

# LLM settings
HAL1000_LLM_PROVIDER=gemini
HAL1000_LLM_BASE_URL=https://generativelanguage.googleapis.com
# REQUIRED: your API key
HAL1000_LLM_API_KEY=REPLACE_ME
HAL1000_LLM_MODEL=gemini-2.5-flash
HAL1000_LLM_TIMEOUT_SECONDS=60

# RAG (optional). When true, requires embedding API key (defaults to HAL1000_LLM_API_KEY if HAL1000_RAG_EMBEDDING_API_KEY unset).
# HAL1000_RAG_ENABLED=true
# HAL1000_RAG_TOP_K=5
# HAL1000_RAG_MAX_PROMPT_CHARS=6000
# HAL1000_RAG_CHUNK_SIZE_CHARS=1200
# HAL1000_RAG_CHUNK_OVERLAP_CHARS=200
# HAL1000_RAG_MAX_URL_BYTES=2000000
# HAL1000_RAG_EMBEDDING_BATCH_SIZE=16
# openai | gemini — can differ from HAL1000_LLM_PROVIDER (e.g. chat=gemini, embeddings=gemini)
# HAL1000_RAG_EMBEDDING_PROVIDER=openai
# HAL1000_RAG_EMBEDDING_MODEL=text-embedding-3-small
# HAL1000_RAG_EMBEDDING_BASE_URL=
# HAL1000_RAG_EMBEDDING_API_KEY=

# Optional: JVM flags (e.g., memory limits)
# JAVA_OPTS=-Xms256m -Xmx512m
